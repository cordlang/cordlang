# App shell — slot is where the active route renders

layout default
  header sticky bg=white shadow=sm
    row between center p=16
      h1 "Cordlang Demo" size=xl bold color=primary
      nav purpose=navigation
        row gap=16 center
          link "Home" to=/ purpose=navigation importance=primary
          link "Counter" to=/counter purpose=navigation
          link "Shop" to=/shop purpose=navigation
          link "About" to=/about purpose=navigation
  main p=24
    slot
  footer muted center p=16
    p "Compiled from Cordlang → React"
