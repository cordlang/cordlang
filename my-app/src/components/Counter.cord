# Reusable component (filename → Counter)

state count=0
props label=""

col gap=12 center p=16
  if label
    p "#{label}" muted purpose=content
  p "Count: #{count}" size=lg purpose=status
  span "#{count}" size=4xl bold color=primary purpose=status
  row gap=8 center
    btn "-" @click=setCount(count - 1) variant=outline purpose=action
    btn "Reset" @click=setCount(0) variant=ghost purpose=action
    btn "+" @click=setCount(count + 1) variant=primary purpose=action importance=primary
