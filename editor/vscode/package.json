{
  "name": "cordlang",
  "displayName": "Cordlang",
  "description": "Minimal Cordlang language support (snippets + check tasks)",
  "version": "0.1.0",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "cordlang",
        "aliases": ["Cordlang", "cord"],
        "extensions": [".cord"],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "cordlang",
        "path": "./snippets/cordlang.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "cordlang-check",
        "owner": "cordlang",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "tasks": [
      {
        "type": "shell",
        "label": "cordlang: check",
        "command": "cordlang check",
        "problemMatcher": ["$cordlang-check"],
        "group": "build"
      }
    ]
  }
}
