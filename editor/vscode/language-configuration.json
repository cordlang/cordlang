{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "(", "close": ")" },
    { "open": "#{", "close": "}" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["(", ")"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(def|layout|if|else|for|form|col|row|grid|card|page|action|fetch)\\b",
    "decreaseIndentPattern": "^\\s*(else)\\b"
  }
}
