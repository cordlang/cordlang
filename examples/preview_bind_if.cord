# Preview contract: state + setX + #{x} + bind + live if
# Not a full SPA — use `cordlang run react|svelte` for real apps.

def PreviewDemo
  state count = 0
  state name = "Ada"
  state open = true

  col gap=16 p=24
    h1 "Preview demo" size=2xl bold
    p "Count: #{count}" muted
    row gap=8
      btn "-" @click=setCount(count - 1) variant=outline
      btn "+" @click=setCount(count + 1) variant=primary
    label "Name"
    input text bind=name placeholder="Your name"
    p "Hello, #{name}"
    if open
      p "Panel visible" color=primary
    else
      p "Panel hidden" muted
    btn "Toggle panel" @click=setOpen(!open) variant=outline
