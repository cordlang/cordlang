col
  section p=48 center gap=16 max-w=3xl mx
    h1 "Ship UI with Cord" size=4xl bold
    p "Dense .cord source → React or Svelte. Built for vibecode." muted size=lg
    row gap=12 center
      btn "Get started" variant=primary
      btn "Docs" variant=outline
  section id=product p=48 gap=16 max-w=3xl mx
