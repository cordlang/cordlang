state email=""
state note=""

fetch products = "/api/products.json"

col gap=24 p=32 max-w=lg mx
  h1 "Contact" size=2xl bold purpose=content importance=primary
  form purpose=form
    col gap=12
      input text bind=email name=email placeholder="Email"
      textarea bind=note name=note placeholder="Message"
      btn "Send" variant=primary purpose=action importance=primary
  col gap=8
    h2 "Catalog preview" size=lg bold purpose=content
    if products
      for p in products key=p.id
        row between p=8 border rounded
          span "#{p.name}"
          span "#{p.price}" muted
    else
      p "Loading…" muted purpose=status
